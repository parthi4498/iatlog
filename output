<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Injector Assembly - Shift Production Detail Record</title>
    <style>
        :root {
            --border-color: #000;
            --bg-header: #f2f2f2;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background-color: #f8f9fa;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: #fff;
            padding: 20px;
            border: 2px solid var(--border-color);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            font-size: 20px;
            text-transform: uppercase;
            margin-top: 0;
            margin-bottom: 15px;
            letter-spacing: 1px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th, td {
            border: 1px solid var(--border-color);
            padding: 6px 8px;
            font-size: 13px;
            text-align: center;
        }

        th {
            background-color: var(--bg-header);
            font-weight: bold;
        }

        .section-header {
            text-align: left;
            background-color: #e6e6e6;
            font-weight: bold;
            font-size: 14px;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"],
        select {
            width: 90%;
            padding: 4px;
            border: 1px solid #ccc;
            border-radius: 3px;
            text-align: center;
            box-sizing: border-box;
        }

        input[readonly] {
            background-color: #eaeaea;
            font-weight: bold;
        }

        .actions {
            text-align: center;
            margin-top: 20px;
        }

        .btn {
            padding: 10px 20px;
            font-size: 14px;
            font-weight: bold;
            color: #fff;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin: 0 5px;
        }

        .btn-success { background-color: #28a745; }
        .btn-secondary { background-color: #6c757d; }

        .btn:hover { opacity: 0.9; }

        @media print {
            .actions { display: none; }
            body { margin: 0; background-color: #fff; }
            .container { border: none; box-shadow: none; width: 100%; max-width: 100%; }
            input { border: none !important; background: transparent !important; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Injector Assembly - Shift Production Detail Record</h1>

    <form id="productionForm">
        <!-- Section 1: Date & Shift Header -->
        <table>
            <tr>
                <td class="section-header" style="width: 25%;">1. Date & Shift</td>
                <td style="text-align: left;">
                    <strong>Date:</strong> <input type="date" id="docDate" style="width: 200px;" required>
                    <strong style="margin-left: 30px;">Shift:</strong> 
                    <select id="docShift" style="width: 120px;" required>
                        <option value="">Select</option>
                        <option value="Shift 1">Shift 1</option>
                        <option value="Shift 2">Shift 2</option>
                        <option value="Shift 3">Shift 3</option>
                    </select>
                </td>
            </tr>
        </table>

        <!-- Summary & Manpower Section (2-6) -->
        <table>
            <thead>
                <tr>
                    <th style="width: 30%; text-align: left;">Section</th>
                    <th>Plan</th>
                    <th>Actual</th>
                    <th>Gap (Plan - Act)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="section-header">2. Shift Manpower (Planned vs Actual - FPD)</td>
                    <td><input type="number" id="mp_plan" oninput="calcGap('mp')"></td>
                    <td><input type="number" id="mp_act" oninput="calcGap('mp')"></td>
                    <td><input type="number" id="mp_gap" readonly></td>
                </tr>
                <tr>
                    <td class="section-header">3. Assembly (Plan vs Actual)</td>
                    <td><input type="number" id="ass_plan" oninput="calcGap('ass')"></td>
                    <td><input type="number" id="ass_act" oninput="calcGap('ass')"></td>
                    <td><input type="number" id="ass_gap" readonly></td>
                </tr>
                <tr>
                    <td class="section-header">4. Testing (Plan vs Actual)</td>
                    <td><input type="number" id="test_plan" oninput="calcGap('test')"></td>
                    <td><input type="number" id="test_act" oninput="calcGap('test')"></td>
                    <td><input type="number" id="test_gap" readonly></td>
                </tr>
                <tr>
                    <td class="section-header">5. P.Off (Plan vs Actual)</td>
                    <td><input type="number" id="poff_plan" oninput="calcGap('poff')"></td>
                    <td><input type="number" id="poff_act" oninput="calcGap('poff')"></td>
                    <td><input type="number" id="poff_gap" readonly></td>
                </tr>
                <tr>
                    <td class="section-header">6. FQC (Plan vs Actual)</td>
                    <td><input type="number" id="fqc_plan" oninput="calcGap('fqc')"></td>
                    <td><input type="number" id="fqc_act" oninput="calcGap('fqc')"></td>
                    <td><input type="number" id="fqc_gap" readonly></td>
                </tr>
            </tbody>
        </table>

        <!-- Section 6: Assembly Line Details -->
        <table>
            <thead>
                <tr>
                    <th colspan="12" class="section-header">6. Assembly Line Details</th>
                </tr>
                <tr>
                    <th colspan="4">LINE 1</th>
                    <th colspan="4">LINE 2</th>
                    <th colspan="4">LINE 3</th>
                </tr>
                <tr>
                    <th>Opr</th><th>Plan</th><th>Act</th><th>Rej/Rwrk</th>
                    <th>Opr</th><th>Plan</th><th>Act</th><th>Rej/Rwrk</th>
                    <th>Opr</th><th>Plan</th><th>Act</th><th>Rej/Rwrk</th>
                </tr>
            </thead>
            <tbody>
                <!-- Row 1 -->
                <tr>
                    <td><input type="text"></td><td><input type="number" class="l1-plan" oninput="calcTotals()"></td><td><input type="number" class="l1-act" oninput="calcTotals()"></td><td><input type="number"></td>
                    <td><input type="text"></td><td><input type="number" class="l2-plan" oninput="calcTotals()"></td><td><input type="number" class="l2-act" oninput="calcTotals()"></td><td><input type="number"></td>
                    <td><input type="text"></td><td><input type="number" class="l3-plan" oninput="calcTotals()"></td><td><input type="number" class="l3-act" oninput="calcTotals()"></td><td><input type="number"></td>
                </tr>
                <!-- Row 2 -->
                <tr>
                    <td><input type="text"></td><td><input type="number" class="l1-plan" oninput="calcTotals()"></td><td><input type="number" class="l1-act" oninput="calcTotals()"></td><td><input type="number"></td>
                    <td><input type="text"></td><td><input type="number" class="l2-plan" oninput="calcTotals()"></td><td><input type="number" class="l2-act" oninput="calcTotals()"></td><td><input type="number"></td>
                    <td><input type="text"></td><td><input type="number" class="l3-plan" oninput="calcTotals()"></td><td><input type="number" class="l3-act" oninput="calcTotals()"></td><td><input type="number"></td>
                </tr>
                <!-- Total Row -->
                <tr style="font-weight: bold; background-color: var(--bg-header);">
                    <td>TOTAL</td>
                    <td><input type="number" id="l1_plan_tot" readonly></td>
                    <td><input type="number" id="l1_act_tot" readonly></td>
                    <td>-</td>
                    <td>TOTAL</td>
                    <td><input type="number" id="l2_plan_tot" readonly></td>
                    <td><input type="number" id="l2_act_tot" readonly></td>
                    <td>-</td>
                    <td>TOTAL</td>
                    <td><input type="number" id="l3_plan_tot" readonly></td>
                    <td><input type="number" id="l3_act_tot" readonly></td>
                    <td>-</td>
                </tr>
            </tbody>
        </table>

        <!-- Grand Total Bar -->
        <table>
            <tr style="background-color: #d1ecf1; font-weight: bold;">
                <td style="width: 70%; text-align: right;">GRAND TOTAL (Planned / Actual):</td>
                <td><input type="text" id="grand_total" readonly style="font-size: 16px; color: #0c5460;"></td>
            </tr>
        </table>

        <div class="actions">
            <button type="button" class="btn" onclick="window.print()">Print Record</button>
            <button type="button" class="btn btn-success" onclick="exportCSV()">Export to Excel (CSV)</button>
            <button type="reset" class="btn btn-secondary">Reset Form</button>
        </div>
    </form>
</div>

<script>
    // Set default date to today
    document.getElementById('docDate').valueAsDate = new Date();

    // Calculate Gap for top section
    function calcGap(prefix) {
        const plan = parseFloat(document.getElementById(prefix + '_plan').value) || 0;
        const act = parseFloat(document.getElementById(prefix + '_act').value) || 0;
        document.getElementById(prefix + '_gap').value = plan - act;
    }

    // Calculate Column Totals for Assembly Lines
    function calcTotals() {
        let sumL1Plan = 0, sumL1Act = 0;
        let sumL2Plan = 0, sumL2Act = 0;
        let sumL3Plan = 0, sumL3Act = 0;

        document.querySelectorAll('.l1-plan').forEach(el => sumL1Plan += parseFloat(el.value) || 0);
        document.querySelectorAll('.l1-act').forEach(el => sumL1Act += parseFloat(el.value) || 0);
        
        document.querySelectorAll('.l2-plan').forEach(el => sumL2Plan += parseFloat(el.value) || 0);
        document.querySelectorAll('.l2-act').forEach(el => sumL2Act += parseFloat(el.value) || 0);

        document.querySelectorAll('.l3-plan').forEach(el => sumL3Plan += parseFloat(el.value) || 0);
        document.querySelectorAll('.l3-act').forEach(el => sumL3Act += parseFloat(el.value) || 0);

        document.getElementById('l1_plan_tot').value = sumL1Plan;
        document.getElementById('l1_act_tot').value = sumL1Act;
        document.getElementById('l2_plan_tot').value = sumL2Plan;
        document.getElementById('l2_act_tot').value = sumL2Act;
        document.getElementById('l3_plan_tot').value = sumL3Plan;
        document.getElementById('l3_act_tot').value = sumL3Act;

        const totalPlan = sumL1Plan + sumL2Plan + sumL3Plan;
        const totalAct = sumL1Act + sumL2Act + sumL3Act;

        document.getElementById('grand_total').value = totalPlan + ' / ' + totalAct;
    }

    // Export filled form data to CSV
    function exportCSV() {
        const date = document.getElementById('docDate').value;
        const shift = document.getElementById('docShift').value;
        
        if (!date || !shift) {
            alert("Please select both Date and Shift before exporting.");
            return;
        }

        let csv = `Injector Assembly - Shift Production Detail Record\n`;
        csv += `Date,${date},Shift,${shift}\n\n`;

        csv += `Section,Plan,Actual,Gap\n`;
        csv += `Shift Manpower,${document.getElementById('mp_plan').value},${document.getElementById('mp_act').value},${document.getElementById('mp_gap').value}\n`;
        csv += `Assembly,${document.getElementById('ass_plan').value},${document.getElementById('ass_act').value},${document.getElementById('ass_gap').value}\n`;
        csv += `Testing,${document.getElementById('test_plan').value},${document.getElementById('test_act').value},${document.getElementById('test_gap').value}\n`;
        csv += `P.Off,${document.getElementById('poff_plan').value},${document.getElementById('poff_act').value},${document.getElementById('poff_gap').value}\n`;
        csv += `FQC,${document.getElementById('fqc_plan').value},${document.getElementById('fqc_act').value},${document.getElementById('fqc_gap').value}\n`;

        const blob = new Blob([csv], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.setAttribute('href', url);
        a.setAttribute('download', `Production_Record_${date}_${shift}.csv`);
        a.click();
    }
</script>

</body>
</html>
Key Features Included:
Header Section: Date and Shift selection.   

Top Metrics Table: Sections 2 through 6 (Manpower, Assembly, Testing, P.Off, FQC) with automatic Gap calculation (Plan - Actual).   

Assembly Line Details Table: Line 1, Line 2, and Line 3 data entry columns with automatic total column calculation and Grand Total calculation.   

Export Capabilities:

Print Record: Uses CSS print styles to hide buttons and prepare the sheet for printing or saving as PDF.

Export to Excel (CSV): Downloads a clean .csv report labeled with the selected Date and Shift.

